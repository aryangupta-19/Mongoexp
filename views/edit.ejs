<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Your Chat</title>
</head>
<body>
    <p>Edit Your Chat</p>
    <p> chat  Id : <%= chat._id %></p>
    <p>This is Chat from <b><%= chat.from %></b> to <b><%= chat.to %></b> </p>
    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea name="msg" rows="16" cols="50"><%= chat.msg %></textarea>
        <br>
        <button>Edit</button>
    </form>
</body>
</html>